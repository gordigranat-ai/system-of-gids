# Скрипты Windows должны лежать в репозитории с переводами строк CRLF:
# cmd.exe плохо читает .bat-файлы с одиночными LF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Остальные текстовые файлы — LF.
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Бинарные файлы не трогаем.
*.sqlite binary
*.png binary
